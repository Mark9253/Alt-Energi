<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maintenance_equipment_form_allenergy" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.allenergy</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Asset Register" name="allenergy_asset_register">
                        <group>
                            <group string="Location">
                                <field name="partner_id" options="{'no_create': True}"/>
                                <field name="client_id" readonly="1"/>
                            </group>
                            <group string="Identification">
                                <field name="asset_type"/>
                                <field name="manufacturer"/>
                                <field name="model_number"/>
                                <field name="serial_number"/>
                                <field name="vg_number" invisible="asset_type != 'boiler'"/>
                            </group>
                            <group string="Lifecycle">
                                <field name="install_date"/>
                                <field name="warranty_end_date"/>
                                <field name="system_capacity_kw"/>
                            </group>
                            <group string="Monitoring">
                                <field name="monitoring_portal"/>
                                <field name="monitoring_plant_id"
                                       invisible="monitoring_portal == 'none'"/>
                            </group>
                            <group string="Service History" colspan="2">
                                <field name="last_service_date" readonly="1"/>
                                <field name="next_service_due_date" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_maintenance_equipment_tree_allenergy" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.allenergy</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="asset_type" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="client_id" optional="show"/>
                <field name="manufacturer" optional="hide"/>
                <field name="model_number" optional="hide"/>
                <field name="serial_number" optional="hide"/>
                <field name="install_date" optional="hide"/>
                <field name="warranty_end_date" optional="hide"/>
                <field name="last_service_date" optional="show"/>
                <field name="next_service_due_date" optional="show"/>
                <field name="monitoring_portal" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_maintenance_equipment_kanban_allenergy" model="ir.ui.view">
        <field name="name">maintenance.equipment.kanban.allenergy</field>
        <field name="model">maintenance.equipment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="partner_id" sample="1">
                <field name="name"/>
                <field name="asset_type"/>
                <field name="manufacturer"/>
                <field name="model_number"/>
                <field name="serial_number"/>
                <field name="partner_id"/>
                <field name="client_id"/>
                <field name="last_service_date"/>
                <field name="next_service_due_date"/>
                <field name="monitoring_portal"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <field name="manufacturer"/>
                                        <t t-if="record.model_number.raw_value">
                                            / <field name="model_number"/>
                                        </t>
                                    </small>
                                </div>
                                <field name="asset_type" widget="label_selection"
                                       options="{'classes': {'solar_panel': 'success', 'inverter': 'info', 'boiler': 'warning', 'pump': 'primary', 'other': 'default'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div t-if="record.client_id.raw_value">
                                    <i class="fa fa-building-o"/> <field name="client_id"/>
                                </div>
                                <div t-if="record.serial_number.raw_value">
                                    <i class="fa fa-barcode"/> S/N: <field name="serial_number"/>
                                </div>
                                <div t-if="record.last_service_date.raw_value">
                                    <i class="fa fa-history"/> Last: <field name="last_service_date"/>
                                </div>
                                <div t-if="record.next_service_due_date.raw_value">
                                    <i class="fa fa-calendar"/> Due: <field name="next_service_due_date"/>
                                </div>
                                <div t-if="record.monitoring_portal.raw_value and record.monitoring_portal.raw_value != 'none'">
                                    <i class="fa fa-rss"/> <field name="monitoring_portal"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_maintenance_equipment_search_allenergy" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.allenergy</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Solar Panel" name="type_solar_panel"
                        domain="[('asset_type','=','solar_panel')]"/>
                <filter string="Inverter" name="type_inverter"
                        domain="[('asset_type','=','inverter')]"/>
                <filter string="Boiler" name="type_boiler"
                        domain="[('asset_type','=','boiler')]"/>
                <separator/>
                <filter string="Has Monitoring" name="has_monitoring"
                        domain="[('monitoring_portal','!=','none'), ('monitoring_portal','!=',False)]"/>
                <filter string="Warranty Active" name="warranty_active"
                        domain="[('warranty_end_date','&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Site" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Client" name="group_client"
                            context="{'group_by': 'client_id'}"/>
                    <filter string="Asset Type" name="group_asset_type"
                            context="{'group_by': 'asset_type'}"/>
                    <filter string="Manufacturer" name="group_manufacturer"
                            context="{'group_by': 'manufacturer'}"/>
                    <filter string="Monitoring Portal" name="group_monitoring_portal"
                            context="{'group_by': 'monitoring_portal'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_allenergy_asset_register" model="ir.actions.act_window">
        <field name="name">Asset Register</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_maintenance_equipment_search_allenergy"/>
        <field name="context">{'search_default_group_partner': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add an asset to the register
            </p>
            <p>
                Each asset is linked to a site (the partner with is_site set).
                Subscriptions and Field Service tasks reference assets through
                the kanban grouping below.
            </p>
        </field>
    </record>

    <menuitem id="menu_allenergy_root"
              name="AllEnergy"
              sequence="15"/>

    <menuitem id="menu_allenergy_asset_register"
              name="Asset Register"
              parent="menu_allenergy_root"
              action="action_allenergy_asset_register"
              sequence="10"/>

</odoo>
