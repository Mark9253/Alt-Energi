<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_postcode_distance_tree" model="ir.ui.view">
        <field name="name">allenergy.postcode.distance.list</field>
        <field name="model">allenergy.postcode.distance</field>
        <field name="arch" type="xml">
            <list string="Postcode Distances" editable="bottom">
                <field name="outward_code"/>
                <field name="area_name"/>
                <field name="distance_miles" sum="Distance (mi)"/>
                <field name="drive_hours" sum="Drive (hrs)"/>
                <field name="active_customer_count" sum="Customers"/>
            </list>
        </field>
    </record>

    <record id="view_postcode_distance_form" model="ir.ui.view">
        <field name="name">allenergy.postcode.distance.form</field>
        <field name="model">allenergy.postcode.distance</field>
        <field name="arch" type="xml">
            <form string="Postcode Distance">
                <sheet>
                    <group>
                        <group>
                            <field name="outward_code"/>
                            <field name="area_name"/>
                        </group>
                        <group>
                            <field name="distance_miles"/>
                            <field name="drive_hours"/>
                            <field name="active_customer_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_postcode_distance_search" model="ir.ui.view">
        <field name="name">allenergy.postcode.distance.search</field>
        <field name="model">allenergy.postcode.distance</field>
        <field name="arch" type="xml">
            <search>
                <field name="outward_code"/>
                <field name="area_name"/>
                <filter string="Local (0-30 mi)" name="band_local"
                        domain="[('distance_miles','&lt;=',30)]"/>
                <filter string="Near (31-75 mi)" name="band_near"
                        domain="[('distance_miles','&gt;',30),('distance_miles','&lt;=',75)]"/>
                <filter string="Mid (76-150 mi)" name="band_mid"
                        domain="[('distance_miles','&gt;',75),('distance_miles','&lt;=',150)]"/>
                <filter string="Far (151+ mi)" name="band_far"
                        domain="[('distance_miles','&gt;',150)]"/>
            </search>
        </field>
    </record>

    <record id="action_postcode_distance" model="ir.actions.act_window">
        <field name="name">Postcode Distances</field>
        <field name="res_model">allenergy.postcode.distance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_postcode_distance_search"/>
    </record>

    <menuitem id="menu_allenergy_configuration"
              name="Configuration"
              parent="menu_allenergy_root"
              groups="allenergy_core.group_allenergy_admin"
              sequence="90"/>

    <menuitem id="menu_postcode_distance"
              name="Postcode Distances"
              parent="menu_allenergy_configuration"
              action="action_postcode_distance"
              sequence="10"/>

</odoo>
