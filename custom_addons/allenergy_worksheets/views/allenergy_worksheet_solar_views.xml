<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_worksheet_solar_item_tree" model="ir.ui.view">
        <field name="name">allenergy.worksheet.solar.item.list</field>
        <field name="model">allenergy.worksheet.solar.item</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="section"/>
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_worksheet_solar_item" model="ir.actions.act_window">
        <field name="name">Solar Worksheet Items</field>
        <field name="res_model">allenergy.worksheet.solar.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_worksheet_solar_form" model="ir.ui.view">
        <field name="name">allenergy.worksheet.solar.form</field>
        <field name="model">allenergy.worksheet.solar</field>
        <field name="arch" type="xml">
            <form string="Solar Worksheet">
                <header>
                    <button name="action_sign" type="object" string="Mark Signed"
                            class="btn-primary"
                            invisible="state == 'signed' or not client_signature"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,signed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="task_id" options="{'no_create': True}"/>
                            <field name="equipment_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="client_id" readonly="1"/>
                            <field name="visit_date"/>
                            <field name="engineer_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inspection" name="inspection">
                            <field name="line_ids">
                                <list editable="bottom" default_order="sequence">
                                    <field name="sequence" widget="handle"/>
                                    <field name="section" optional="show"/>
                                    <field name="name" readonly="1"/>
                                    <field name="status"/>
                                    <field name="comments"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sign-Off" name="signoff">
                            <group>
                                <group string="Overall">
                                    <field name="overall_condition"/>
                                </group>
                                <group string="Client Sign-Off">
                                    <field name="client_print_name"/>
                                    <field name="client_position"/>
                                    <field name="client_signature" widget="signature"/>
                                    <field name="client_signature_date"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_worksheet_solar_tree" model="ir.ui.view">
        <field name="name">allenergy.worksheet.solar.list</field>
        <field name="model">allenergy.worksheet.solar</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="task_id"/>
                <field name="equipment_id"/>
                <field name="partner_id"/>
                <field name="visit_date"/>
                <field name="engineer_id"/>
                <field name="overall_condition"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_worksheet_solar" model="ir.actions.act_window">
        <field name="name">Solar Worksheets</field>
        <field name="res_model">allenergy.worksheet.solar</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_worksheet_solar"
              name="Solar Worksheets"
              parent="allenergy_worksheets.menu_allenergy_worksheets"
              action="action_worksheet_solar"
              sequence="20"/>

    <menuitem id="menu_worksheet_solar_item"
              name="Solar Items (Master)"
              parent="allenergy_core.menu_allenergy_configuration"
              action="action_worksheet_solar_item"
              sequence="30"/>

</odoo>
